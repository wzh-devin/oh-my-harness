{
  "name": "@oh-my-harness/agent-runtime",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test --experimental-strip-types src/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "prettier --write src package.json tsconfig.json tsconfig.build.json",
    "format:check": "prettier --check src package.json tsconfig.json tsconfig.build.json"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.3",
    "@earendil-works/pi-ai": "0.84.3",
    "@oh-my-harness/agent-plugins": "workspace:*",
    "@oh-my-harness/agent-policy": "workspace:*",
    "@oh-my-harness/agent-tools": "workspace:*",
    "@oh-my-harness/llm": "workspace:*",
    "@oh-my-harness/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "oxlint": "^1.75.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2"
  }
}
