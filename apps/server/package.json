{
  "name": "@oh-my-harness/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "test": "node --test --experimental-strip-types src/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "prettier --write src package.json tsconfig.json tsconfig.build.json",
    "format:check": "prettier --check src package.json tsconfig.json tsconfig.build.json"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.3",
    "@hono/node-server": "2.1.1",
    "@oh-my-harness/agent-plugins": "workspace:*",
    "@oh-my-harness/agent-policy": "workspace:*",
    "@oh-my-harness/agent-runtime": "workspace:*",
    "@oh-my-harness/agent-tools": "workspace:*",
    "@oh-my-harness/llm": "workspace:*",
    "@oh-my-harness/shared": "workspace:*",
    "hono": "4.13.5"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.3",
    "@types/node": "^24.13.3",
    "oxlint": "^1.75.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2"
  }
}
